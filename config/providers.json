{
  "openrouter": {
    "label": "OpenRouter",
    "adapter": "responses",
    "endpoint": "https://openrouter.ai/api/v1/responses",
    "default_model": "nvidia/nemotron-3-ultra-550b-a55b:free",
    "models": {
      "nvidia/nemotron-3-ultra-550b-a55b:free": {"output_limit": 4096}
    }
  },
  "merge": {
    "label": "Merge Gateway",
    "adapter": "responses",
    "endpoint": "https://api-gateway.merge.dev/v1/openai/responses",
    "default_model": "zai/glm-5.3-flash",
    "models": {
      "zai/glm-5.3-flash": {"output_limit": 16384}
    }
  },
  "opencode": {
    "label": "OpenCode Zen",
    "adapter": "opencode",
    "endpoint": "https://opencode.ai/zen/v1/chat/completions",
    "default_model": "space-bunny-free",
    "models": {
      "step-5-preview-free": {"output_limit": 4096},
      "space-bunny-free": {"output_limit": 4096, "send_variant": true}
    }
  }
}
